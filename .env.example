# ── Copy this file to .env and fill your real credentials ──

# ── Channel Discovery / Research Keys ────────────────────────────────────────

# YouTube Data API v3 key — free 10,000 quota units/day
# Enables YouTube trending + channel search in the hunter
# Get it: https://console.cloud.google.com → APIs & Services → Enable YouTube Data API v3
# NOTE: separate from YOUTUBE_CLIENT_ID/SECRET — this is a simple API key, not OAuth
YOUTUBE_DATA_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# Tavily Search API — OPTIONAL, enables deep premium web research
# Free tier: 1,000 searches/month at https://tavily.com
# Recommended if you want real web data beyond Google Trends
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ── NotebookLM Integration (3 options — choose one) ──────────────────────────
#
# OPTION 1 (RECOMMENDED — Free): Gemini API with Google Search grounding
#   → Already works with GEMINI_API_KEY above, set GEMINI_USE_GROUNDING=true
GEMINI_USE_GROUNDING=true
#
# OPTION 2 (Enterprise — requires GCP license): NotebookLM Enterprise API
#   → Requires Google Cloud project + Gemini Enterprise license
#   → https://docs.cloud.google.com/gemini/enterprise/notebooklm-enterprise/docs/api-notebooks
NOTEBOOKLM_ENTERPRISE_PROJECT=YOUR_GCP_PROJECT_ID
#
# OPTION 3 (Unofficial — browser automation): notebooklm-py library
#   → pip install "notebooklm-py[browser]" && playwright install chromium
#   → Uses undocumented Google APIs, may break on Google updates
#   → GitHub: https://github.com/teng-lin/notebooklm-py
NOTEBOOKLM_USE_UNOFFICIAL=false
NOTEBOOKLM_NOTEBOOK_ID=YOUR_NOTEBOOKLM_NOTEBOOK_ID

# ── Original pipeline keys below ──────────────────────────────────────────────

# Google AI Studio — get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Video Generation — Multi-Provider (escolha um ou mais) ───────────────────
#
# OPÇÃO 1: Veo3 via Vertex AI (Google Cloud) — premium, $0.15-0.40/seg
#   Precisa: projeto GCP + billing + Vertex AI API habilitada
#   Melhor para: dark/finance clips hero, qualidade máxima
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
VEO3_TIER=fast
#
# OPÇÃO 2: Kling AI — melhor custo-benefício, $0.042-0.112/seg ← RECOMENDADO
#   Crie conta: https://developer.klingai.com/
#   KLING_DEFAULT_TIER: turbo_720p ($0.042/s) | turbo_1080p ($0.07/s) | standard_720p ($0.084/s) | standard_1080p ($0.112/s)
KLING_API_KEY=YOUR_KLING_API_KEY
KLING_DEFAULT_TIER=turbo_720p
#
# OPÇÃO 3: Higgsfield AI — fallback, acessa Kling/Seedance/Wan via API unificada
#   Já disponível via MCP nesta sessão. Configure HIGGSFIELD_API_KEY se quiser via REST.
# HIGGSFIELD_API_KEY=YOUR_HIGGSFIELD_API_KEY
#
# VIDEO_PROVIDER: auto = usa o que estiver configurado (Veo3 > Kling > Higgsfield > Pexels)
VIDEO_PROVIDER=auto

# Pexels free API — https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_API_KEY

# Pixabay free API — https://pixabay.com/api/docs/
PIXABAY_API_KEY=YOUR_PIXABAY_API_KEY

# YouTube OAuth (from Google Cloud Console → Credentials)
YOUTUBE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

# Google Sheets service-account JSON path (for reading topics)
GOOGLE_SHEETS_CREDS_JSON=config/sheets_credentials.json

# ── TTS Premium (ElevenLabs) — 58-68% retenção vs 35-45% edge-tts ───────────
# Crie conta: https://elevenlabs.io/ — free tier: 10k chars/mês
# TTS_TIER: free = edge-tts (padrão) | premium = ElevenLabs
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
TTS_TIER=free

# Voice config (pt-BR-AntonioNeural = deep male, pt-BR-FranciscaNeural = female)
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=-5%
TTS_PITCH=-10Hz

# Video output quality
VIDEO_BITRATE=5000k

# Scene duration in seconds (how long each image stays on screen)
SCENE_DURATION=5

# Upload privacy: private | unlisted | public
YT_PRIVACY=private

# Max videos rendered in parallel (reduce if your machine is slow)
MAX_PARALLEL=2

# Daily scheduler hour (24h format, local time)
SCHEDULE_HOUR=6

# ── Notificações (Telegram) ─────────────────────────────────────────────────
# Para receber relatórios semanais no celular:
#   1. Crie um bot: https://t.me/BotFather → /newbot
#   2. Pegue o chat_id: envie uma mensagem ao bot e acesse
#      https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
